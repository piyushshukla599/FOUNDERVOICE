# TLS for the FounderVoice API.
#
# Caddy obtains and renews a Let's Encrypt certificate on its own, so this
# file plus the A record is the whole of it. TLS is not optional here:
# browsers refuse getUserMedia (the microphone) on plain HTTP from a remote
# origin, so without this the product's one feature does not run.
#
# tls-setup.sh substitutes API_HOST_PLACEHOLDER for the real hostname when it
# installs this, so the file stays domain-agnostic and moving to another
# domain is a one-command change:
#
#   API_HOST=api.example.com WEB_ORIGIN=https://example.com \n#     bash ~/voicecoach/deploy/tls-setup.sh
#
# The A record must already resolve before reloading — Caddy proves ownership
# over port 80 and will fail loudly if DNS is not live yet.

API_HOST_PLACEHOLDER {
	reverse_proxy 127.0.0.1:8000 {
		# Overwrite rather than append. The API derives its per-visitor quota
		# from this header, so a caller who could prepend their own value
		# would choose their own identity and get a fresh allowance per
		# request. {remote_host} is the address Caddy actually accepted.
		header_up X-Forwarded-For {remote_host}

		# Transcription is synchronous and CPU-bound; a long recording can hold
		# the connection for minutes. Caddy's default 30s would cut it off and
		# the browser would report a bare network error, hiding the cause.
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}

	# Uploads are audio, not JSON.
	request_body {
		max_size 60MB
	}

	encode gzip
}

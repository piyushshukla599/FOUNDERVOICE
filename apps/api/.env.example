DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
WHISPER_MODEL=large-v3
# For faster CPU setup use: base or small, then switch to large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
DATA_DIR=../../data
CORS_ORIGINS=http://localhost:3000

# Contact / feedback form → your inbox (optional)
CONTACT_TO_EMAIL=you@yourcompany.com
CONTACT_FROM_EMAIL=noreply@yourcompany.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Set false on public API deploys if you want to hide Swagger
API_DOCS_ENABLED=true

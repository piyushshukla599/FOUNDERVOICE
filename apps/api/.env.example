DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Transcription engine.
#   local = faster-whisper runs in this process. Nothing leaves the machine,
#           but it needs ~2 GB of free RAM. Use this when self-hosting.
#   groq  = a hosted Whisper does the transcription. Audio is uploaded to
#           Groq, so say so in your privacy copy. Free tier, and small hosts
#           can actually run it.
ASR_PROVIDER=local
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

# Only used when ASR_PROVIDER=local
WHISPER_MODEL=large-v3
# For faster CPU setup use: base or small, then switch to large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
DATA_DIR=../../data
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002

# Contact / feedback form → your inbox (optional)
CONTACT_TO_EMAIL=info@foundervoice.app
CONTACT_FROM_EMAIL=info@foundervoice.app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Set false on public API deploys if you want to hide Swagger
API_DOCS_ENABLED=true

# --- Free-tier quotas -------------------------------------------------------
# Caps what one anonymous visitor can spend on the expensive paths.
QUOTA_ENABLED=true
FREE_UPLOAD_LIMIT=10
# Counters roll: the full allowance returns this many hours after first use.
QUOTA_WINDOW_HOURS=24
# Set to none only when the API is on a domain unrelated to the website.
WORKSPACE_COOKIE_SAMESITE=lax
FREE_PRACTICE_LIMIT=2
FREE_PRACTICE_TURN_LIMIT=20
# REQUIRED in production. Without it, counters reset on every restart.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
QUOTA_SECRET=
# Behind Cloudflare set: cf-connecting-ip
# Behind a plain reverse proxy set: x-forwarded-for
# Leave EMPTY when the API is reachable directly, or callers can forge their identity.
TRUSTED_PROXY_HEADER=
# Loopback/LAN callers (you) are never counted.
QUOTA_EXEMPT_PRIVATE=true
UPGRADE_URL=/contact?interest=pro

# --- Coach voice (text to speech) -------------------------------------------
# The coach speaks its review as well as writing it. Default is FREE: the
# browser says the lines with its own built-in voice - no key, no account, no
# per-character bill, and on Edge/macOS/iOS a neural voice that sounds human.
#   off        = browser voice only (default, free)
#   auto       = use the first hosted provider below that has a key
#   elevenlabs | openai | groq = force one
# Hosted providers are opt-in on purpose: a GROQ_API_KEY set for transcription
# must never quietly start billing for speech. Only finished coaching text is
# sent, never audio.
TTS_PROVIDER=off
ELEVENLABS_API_KEY=
# The voice id decides most of how human the coach sounds. Default is Rachel.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
OPENAI_API_KEY=
OPENAI_TTS_VOICE=onyx
# Reuses GROQ_API_KEY above when TTS_PROVIDER=groq.
GROQ_TTS_VOICE=Fritz-PlayAI
